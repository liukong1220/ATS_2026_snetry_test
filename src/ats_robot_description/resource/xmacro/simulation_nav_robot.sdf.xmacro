<?xml version="1.0"?>
<sdf version="1.7">

    <!--include defination-->
    <xmacro_include uri="model://rplidar_a2/model.sdf.xmacro" />
    <xmacro_include uri="model://mid360/model.sdf.xmacro" />
    <xmacro_include uri="model://industrial_camera/model.sdf.xmacro" />
    <xmacro_include uri="model://rm25_example_robot/rm25_example_robot.def.xmacro" />
    <!--property defination-->
    <xmacro_define_value name="global_initial_color" value="none" />
    <xmacro_define_value name="global_armor_sticker_type" value="num3" />
    <!-- 坐标约定：
         x 向前，y 向左，z 向上；
         欧拉角顺序为 roll pitch yaw，单位 rad。 -->
    <!-- 底盘距离水平地面的高度 -->
    <xmacro_define_value name="chassis_height" value="0.11" />
    <!-- 大 yaw 轴中心相对于底盘参考点的 z 轴安装偏移 -->
    <xmacro_define_value name="gimbal_yaw_height" value="0.04" />
    <!-- pitch 轴中心相对小 yaw 轴中心的安装偏置：
         x<0 表示在小 yaw 轴后方，y>0 表示在左侧，z>0 表示在上方。 -->
    <xmacro_define_value name="pitch_offset_x" value="-0.053" />
    <xmacro_define_value name="pitch_offset_y" value="0.0" />
    <xmacro_define_value name="pitch_offset_z" value="0.064" />
    <!-- 小 yaw 轴中心相对大 yaw 轴中心的安装偏置；
         非共轴结构必须按实车测量填写。 -->
    <xmacro_define_value name="small_yaw_offset_x" value="0.061" />
    <xmacro_define_value name="small_yaw_offset_y" value="0.00" />
    <xmacro_define_value name="small_yaw_offset_z" value="0.131" />

    <!--ats_sentry_robot model-->
    <model name="ats_sentry_robot">

        <!-- 整车模型原点相对世界原点的初始位姿。
             这里的 z=0.15 用于把模型整体抬到地面以上。 -->
        <pose>0 0 0.15 0 0 0</pose>
        <xmacro_block name="rm25_example_robot" sticker_type="${global_armor_sticker_type}" chassis_height="${chassis_height}" gimbal_yaw_height="${gimbal_yaw_height}" small_yaw_offset_x="${small_yaw_offset_x}" small_yaw_offset_y="${small_yaw_offset_y}" small_yaw_offset_z="${small_yaw_offset_z}" pitch_offset_x="${pitch_offset_x}" pitch_offset_y="${pitch_offset_y}" pitch_offset_z="${pitch_offset_z}"/>
        <!-- Livox 相对大 yaw 坐标系 `gimbal_yaw_odom` 的安装位姿：
             pose = x y z roll pitch yaw。 -->
        <xmacro_block name="livox" prefix="front_" parent="gimbal_yaw_odom" pose="-0.1 0.245 0.325 ${75*pi/180} 0 -${161*pi/180}" update_rate="20" samples="1875"/>
        <!-- 工业相机相对 pitch 坐标系 `gimbal_pitch` 的安装位姿：
             pose = x y z roll pitch yaw。 -->
        <xmacro_block name="industrial_camera" prefix="front_" parent="gimbal_pitch" pose="0.1 0 0.045 0 0 0" update_rate="30" horizontal_fov="1" width="1920" height="1080"/>

        <!--plugins-->
        <!-- https://github.com/gazebosim/gz-sim/blob/ign-gazebo6/src/systems -->

        <!--plugin for joint state sensor-->
        <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
        </plugin>

        <!--
            Gazebo Fortress / ign-gazebo6 currently crashes in the rendering thread when
            LightBarController recreates light_bar_visual entities for this simulation model.
            Disable the purely cosmetic plugin here so the simulator can advance and publish
            clock / lidar / odometry for navigation validation.
        -->

        <!--plugin for chassis control-->
        <plugin filename="MecanumDrive2" name="ignition::gazebo::systems::MecanumDrive2">
            <chassis_link>chassis</chassis_link>
            <front_left_joint>front_left_wheel_joint</front_left_joint>
            <front_right_joint>front_right_wheel_joint</front_right_joint>
            <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
            <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
        </plugin>

        <!--plugin for gimbal control-->
        <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
            <joint_name>gimbal_yaw_joint</joint_name>
            <use_force_commands>false</use_force_commands>
            <p_gain>0.2</p_gain>
            <i_gain>0.01</i_gain>
        </plugin>

        <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
            <joint_name>gimbal_pitch_joint</joint_name>
            <use_force_commands>false</use_force_commands>
            <p_gain>1</p_gain>
            <i_gain>0.01</i_gain>
        </plugin>

        <!--plugin for shooter-->
        <plugin filename="ProjectileShooter" name="ignition::gazebo::systems::ProjectileShooter">
            <shooter_link>speed_monitor</shooter_link>
            <shooter_offset>0.15 0 0 0 0 0</shooter_offset>
            <shooter_name>small_shooter</shooter_name>
            <projectile_velocity>20</projectile_velocity>
            <projectile_uri>model://rm_projectile_17mm</projectile_uri>
        </plugin>
    </model>
</sdf>
