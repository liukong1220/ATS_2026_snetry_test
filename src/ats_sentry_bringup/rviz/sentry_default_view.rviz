# Generated navigation view (keep the three ATS RViz configs in sync).
# Global: fused RC-ESDF; local: ROGMap range boxes (no voxel clouds);
# paths: JPS -> MINCO -> MPC horizon/prediction, all in odom (ground z = 0).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: robot_description
      Enabled: true
      Name: Robot Model
      TF Prefix: ''
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: false
    - Alpha: 0.62
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Global Fused RC-ESDF (ROGMap + Static + Terrain)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rc_esdf/signed_distance_grid
      Use Timestamp: false
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: Planning Grid (JPS occupancy)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rc_esdf/planning_grid
      Use Timestamp: false
      Value: false
    - Alpha: 0.3
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: Static Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 'ROGMap Bounds: Orange Local / Green Update'
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rog_map/bounds
      Value: true
    - Alpha: 0.85
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 220; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.025
      Name: Global Planning / JPS Search Path
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Color: 0; 220; 255
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /minco/raw_path
      Value: true
    - Alpha: 0.95
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 50; 255; 80
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Local Control / MINCO Timed Reference
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Color: 50; 255; 80
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /minco/reference_path
      Value: true
    - Alpha: 0.95
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 196; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: MPC Follow / Active Reference Horizon
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Color: 255; 196; 0
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ats_swerve_mpc/reference_horizon
      Value: true
    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 80; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.075
      Name: MPC Prediction / iLQR Follow Rollout
      Offset:
        X: 0
        Y: 0
        Z: 0.12
      Pose Color: 255; 80; 255
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ats_swerve_mpc/predicted_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 18
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Name: Current View
    Near Clip Distance: 0.01
    Pitch: 1.0
    Target Frame: <Fixed Frame>
    Yaw: 0.8
  Saved: null
Window Geometry:
  Height: 1000
  Width: 1600
  X: 60
  Y: 60
