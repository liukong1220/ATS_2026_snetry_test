# Root vcstool manifest for the ATS 2026 sentry workspace.
#
# Import from the workspace root with:
#   vcs import --recursive --skip-existing . < dependencies.repos
#
# src/ats_sentry_bringup is intentionally kept in the root workspace repository
# because it owns the complete robot startup entrypoints, deployment parameters,
# maps, PCD assets and RViz views. Do not add it here as a split repository.
#
# Repository paths are grouped by domain:
#   src/sim/*                  simulation repositories
#   src/interfaces/*           message/interface repositories
#   src/ats_sentry_nav/*       navigation-domain packages and helpers
#   src/tools/*                workspace tools
repositories:
  src/sim/ats_mujoco_sim:
    type: git
    url: git@github.com:liukong1220/ats_mujoco_sim.git
    version: develop

  src/ats_robot_description:
    type: git
    url: git@github.com:liukong1220/ats_robot_description.git
    version: develop

  src/ats_sentry_behavior:
    type: git
    url: git@github.com:liukong1220/ats_sentry_behavior.git
    version: develop

  src/ats_sentry_nav:
    type: git
    url: git@github.com:liukong1220/ats_sentry_nav.git
    version: develop

  src/interfaces:
    type: git
    url: git@github.com:liukong1220/interfaces.git
    version: develop

  src/interfaces/carstatemsgs:
    type: git
    url: git@github.com:liukong1220/carstatemsgs.git
    version: develop

  src/sim/loopback_sim:
    type: git
    url: git@github.com:liukong1220/loopback_sim.git
    version: develop

  src/interfaces/manda_can_control:
    type: git
    url: git@github.com:liukong1220/manda_can_control.git
    version: develop

  src/ats_sentry_nav/sentry_chassis_vel_transform:
    type: git
    url: git@github.com:liukong1220/sentry_chassis_vel_transform.git
    version: develop

  src/standard_robot_pp_ros2:
    type: git
    url: git@github.com:liukong1220/standard_robot_pp_ros2.git
    version: develop

  src/sp_vision25:
    type: git
    url: git@github.com:liukong1220/sp_vision25.git
    version: de

  src/tools/teleop_gimbal_keyboard:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/teleop_gimbal_keyboard.git
    version: main

  src/tools/pcd2pgm:
    type: git
    url: https://github.com/LihanChen2004/pcd2pgm.git
    version: main

  src/tools/rosbag2_composable_recorder:
    type: git
    url: https://github.com/berndpfrommer/rosbag2_composable_recorder.git
    version: c0c9b225dfca54334ac4ca453e307bb017c8a322

  src/dependencies/sdformat_tools:
    type: git
    url: https://github.com/gezp/sdformat_tools.git
    version: galactic

  src/dependencies/joint_state_publisher:
    type: git
    url: https://github.com/LihanChen2004/joint_state_publisher.git
    version: feat-offset-timestamp

  src/dependencies/rmoss_core:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_core.git
    version: humble

  src/dependencies/rmoss_gazebo:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_gazebo.git
    version: humble

  src/dependencies/rmoss_gz_resources:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_gz_resources.git
    version: humble

  src/dependencies/rmoss_interfaces:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmoss_interfaces.git
    version: humble

  src/dependencies/BehaviorTree.ROS2:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/BehaviorTree.ROS2.git
    version: humble

  src/sim/rmu_gazebo_simulator:
    type: git
    url: https://github.com/SMBU-PolarBear-Robotics-Team/rmu_gazebo_simulator.git
    version: main
